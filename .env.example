# Copie para .env.local e preencha. O .env.local NÃO vai pro git.
# Use UMA das duas credenciais abaixo:

# Opção A — chave de API avulsa (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Opção B — token OAuth da sua assinatura Claude (rode `claude setup-token`)
# ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-...

# Opcional — modelo usado para gerar a aula (default: claude-opus-4-8)
BEGOOD_MODEL=claude-opus-4-8
