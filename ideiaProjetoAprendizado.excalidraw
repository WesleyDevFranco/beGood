      "isDeleted": false,
      "boundElements": null,
      "updated": 1783142298311,
      "link": null,
      "locked": false,
      "text": "INICIALMENTE, A TÍTULO DE COLOCAR O PROJETO PARA FUN-\nCIONAR, VAMOS FOCAR SOMENTE EM PASSAR UM DIRETÓRIO, E\nO CLAUDE DEVERÁ RECEBER UMA INSTRUÇÃO DETALHADA PARA\nO \"LABORATÓRIO\" -> UMA APLICAÇÃO WEB QUE IRÁ ABRIR COM\nTODA UMA AULA, E AJUDA O DEV JÚNIOR A IR PARA A PRÁTICA\nE ENTENDER O QUE A IA ESTÁ FAZENDO",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "INICIALMENTE, A TÍTULO DE COLOCAR O PROJETO PARA FUN-\nCIONAR, VAMOS FOCAR SOMENTE EM PASSAR UM DIRETÓRIO, E\nO CLAUDE DEVERÁ RECEBER UMA INSTRUÇÃO DETALHADA PARA\nO \"LABORATÓRIO\" -> UMA APLICAÇÃO WEB QUE IRÁ ABRIR COM\nTODA UMA AULA, E AJUDA O DEV JÚNIOR A IR PARA A PRÁTICA\nE ENTENDER O QUE A IA ESTÁ FAZENDO",
      "autoResize": true,
